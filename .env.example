# Copia este archivo a .env y pon tu clave. .env está en .gitignore: nunca lo subas.
# Solo el chat (Tlamatini) y el nombrado de ramas usan la API de DeepSeek;
# el mapa, la búsqueda y el lector funcionan sin clave.
DS_TOKEN=
# Modelo de DeepSeek. Por defecto: deepseek-v4-flash (rápido y barato).
DS_MODEL=deepseek-v4-flash
